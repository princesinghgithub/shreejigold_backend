# ---- MongoDB Atlas ----
# Atlas में cluster बनाकर "Connect → Drivers" से यह पता कॉपी करें.
# पासवर्ड में @ या : हो तो उसे URL-encode करना पड़ता है.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/shreeji_gold?retryWrites=true&w=majority
# खाली छोड़ें — URI में लिखा database (/shreeji_gold) ही चलेगा. यहाँ कोई और नाम लिखा
# तो डेटा किसी दूसरे (खाली) database में जाने लगेगा.
MONGODB_DB=

# सर्वर किस पोर्ट पर चले (Vercel पर इसकी ज़रूरत नहीं)
PORT=4000

# लॉगिन टोकन की secret key — hosting पर लंबी random string ज़रूर डालें
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=30d

# ऐप कहाँ से खुलेगा. Vercel पर: https://admin.shreejigold.shop
CORS_ORIGIN=http://localhost:5173

# दुकान के अपने नेटवर्क (192.168.x) से मोबाइल अपने आप allow
CORS_ALLOW_LAN=true

# रोज़ का अपने आप backup, और कितनी पुरानी कॉपियाँ रखें
AUTO_BACKUP=true
BACKUP_KEEP=30

# Vercel Cron इसी key से रोज़ का backup चलाता है — लंबी random string रखें
CRON_SECRET=change-this-too

# लॉगिन स्क्रीन / API से पहला खाता बनाना — बंद (true सिर्फ टेस्ट के लिए). मालिक का खाता नीचे वाले
# ADMIN_USER_ID / ADMIN_PASSWORD से "npm run seed:admin" बनाता है, बाकी users अंदर Users पेज से
ALLOW_SETUP=false

# ऐप का लॉगिन खाता — npm run seed:admin इन्हीं से खाता बनाता/बदलता है
ADMIN_USER_ID=you@example.com
ADMIN_PASSWORD=change-this-password

# पासवर्ड भूलने पर OTP वाला email — यूज़र ID email हो तो उसी पते पर OTP जाता है.
# तरीका 1 — Brevo (BREVO_API_KEY हो तो यही चलता है). Brevo → SMTP & API → API Keys
BREVO_API_KEY=
# Brevo में Senders में verify किया हुआ email (SMTP वाले तरीके में भी "From" यही बनता है)
MAIL_FROM_EMAIL=you@example.com
MAIL_FROM_NAME=Shreeji Gold
# तरीका 2 — Gmail: 2-Step Verification चालू करके "App passwords" से 16 अक्षर का पासवर्ड बनाएं
SMTP_USER=you@gmail.com
SMTP_PASS=
# दूसरी मेल सेवा हो तो: SMTP_HOST=smtp.example.com  SMTP_PORT=587

# लॉगिन पर ज़्यादा से ज़्यादा कितनी गलत कोशिशें, कितने मिनट में
LOGIN_MAX_ATTEMPTS=20
LOGIN_WINDOW_MINUTES=15
